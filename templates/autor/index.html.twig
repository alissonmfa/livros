{% extends 'base.html.twig' %}

{% block title %}Autores{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Autores</h1>
        <a class="btn btn-primary" href="{{ path('autor_new') }}">Novo</a>
    </div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nome</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for autor in autores %}
                <tr>
                    <td>{{ autor.nome }}</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('autor_edit', {autor: autor.codAu}) }}">Editar</a>
                        <form class="d-inline" method="post" action="{{ path('autor_delete', {autor: autor.codAu}) }}" onsubmit="return confirm('Excluir este autor?')">
                            <button class="btn btn-sm btn-outline-danger">Excluir</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="2">Nenhum autor cadastrado.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
